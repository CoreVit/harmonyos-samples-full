{
  module: {
    name: 'multimobilepaymentwatchsample',
    type: 'feature',
    description: '$string:module_desc',
    mainElement: 'MultimobilepaymentwatchAbility',
    deviceTypes: [
      'wearable',
    ],
    deliveryWithInstall: false,
    installationFree: false,
    pages: '$profile:main_pages',
    abilities: [
      {
        name: 'MultimobilepaymentwatchAbility',
        srcEntry: './ets/wearableability/WearableAbility.ets',
        description: '$string:WearableAbility_desc',
        icon: '$media:layered_image',
        label: '$string:WearableAbility_label',
        startWindowIcon: '$media:startIcon',
        startWindowBackground: '$color:start_window_background',
        exported: true,
        skills: [
          {
            entities: [
              'entity.system.home',
            ],
            actions: [
              'ohos.want.action.home',
            ],
          },
        ],
      },
    ],
    extensionAbilities: [
      {
        name: 'WearableBackupAbility',
        srcEntry: './ets/wearablebackupability/WearableBackupAbility.ets',
        type: 'backup',
        exported: false,
        metadata: [
          {
            name: 'ohos.extension.backup',
            resource: '$profile:backup_config',
          },
        ],
      },
    ],
  },
}