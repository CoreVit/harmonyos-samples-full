          when: 'inuse',
        },
      },
      {
        name: 'ohos.permission.LOCATION',
        reason: '$string:shared_desc',
        usedScene: {
          abilities: [
            'MultitravelnavigationpcAbility',
          ],
          when: 'inuse',
        },
      },
    ],
    deliveryWithInstall: false,
    installationFree: false,
    pages: '$profile:main_pages',
    abilities: [
      {
        name: 'MultitravelnavigationpcAbility',
        srcEntry: './ets/pcability/PcAbility.ets',
        description: '$string:PcAbility_desc',
