        startWindowIcon: '$media:app_icon',
        startWindowBackground: '$color:start_window_background',
        exported: false,
        skills: [
          {
            entities: [
              'entity.system.home',
            ],
            actions: [
              'action.system.home',
            ],
          },
        ],
        minWindowHeight: 500,
        minWindowWidth: 1080,
      },
