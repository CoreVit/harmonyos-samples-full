{
  module: {
    name: 'default',
    type: 'feature',
    description: '$string:module_desc',
    mainElement: 'MultitravelnavigationAbility',
    deviceTypes: [
      'phone',
      'tablet',
    ],
    requestPermissions: [
      {
        name: 'ohos.permission.APPROXIMATELY_LOCATION',
        reason: '$string:shared_desc',
